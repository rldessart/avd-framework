function [GZ, ASA, AVD] = compute_all_attributes(T, dx)

  % Derivatives
  [dTdz, dTdx] = gradient(T, dx);

  % Vertical derivative
  GZ = dTdz;

  % Analytic Signal Amplitude
  ASA = sqrt(dTdx.^2 + dTdz.^2);

  % ASA-weighted Vertical Derivative
  epsilon = 1e-6;
  AVD = GZ ./ (ASA + epsilon);

end
